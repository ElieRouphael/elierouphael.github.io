---

<div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Photo lightbox">
  <button class="lightbox-close" aria-label="Close lightbox">&times;</button>
  <button class="lightbox-prev" aria-label="Previous photo">&#8249;</button>
  <img class="lightbox-img" src="" alt="" />
  <p class="lightbox-caption"></p>
  <button class="lightbox-next" aria-label="Next photo">&#8250;</button>
</div>

<script>
  const lightbox = document.getElementById('lightbox');
  if (lightbox) {
    const lbImg = lightbox.querySelector('.lightbox-img') as HTMLImageElement | null;
    const lbCaption = lightbox.querySelector('.lightbox-caption') as HTMLElement | null;
    const lbClose = lightbox.querySelector('.lightbox-close') as HTMLButtonElement | null;
    const lbPrev = lightbox.querySelector('.lightbox-prev') as HTMLButtonElement | null;
    const lbNext = lightbox.querySelector('.lightbox-next') as HTMLButtonElement | null;
    const items = Array.from(document.querySelectorAll<HTMLElement>('.gallery-item'));
    let current = 0;

    function showSlide(index: number) {
      if (!items.length || !lbImg || !lbCaption) return;
      current = (index + items.length) % items.length;
      const img = items[current].querySelector('img');
      const cap = items[current].querySelector('.gallery-caption');
      if (img) {
        lbImg.src = (img as HTMLImageElement).src;
        lbImg.alt = (img as HTMLImageElement).alt;
      }
      lbCaption.textContent = cap ? cap.textContent ?? '' : '';
    }

    items.forEach((item, i) => {
      item.addEventListener('click', () => {
        showSlide(i);
        lightbox.classList.add('active');
      });
    });

    lbClose?.addEventListener('click', () => lightbox.classList.remove('active'));
    lbPrev?.addEventListener('click', () => showSlide(current - 1));
    lbNext?.addEventListener('click', () => showSlide(current + 1));
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) lightbox.classList.remove('active');
    });
    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') lightbox.classList.remove('active');
      if (e.key === 'ArrowLeft') showSlide(current - 1);
      if (e.key === 'ArrowRight') showSlide(current + 1);
    });
  }
</script>
