---
import BaseLayout from '../layouts/BaseLayout.astro';
import ItemCard from '../components/ItemCard.astro';
import { research } from '../data/research';
---

<BaseLayout title="Elie Rouphael \u2014 Research">
  <div class="container">
    <div class="page-title">
      <h1>Research</h1>
    </div>

    <div class="item-list">
      {
        research.map((item) => (
          <ItemCard
            title={item.title}
            description={item.description}
            tag={item.tag}
            metaTop={item.year}
            metaBottom={item.venue}
            href={item.href}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
