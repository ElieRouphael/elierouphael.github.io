---
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner container">
    <div class="footer-body">
      <div class="footer-left">
        <h2 class="footer-name">Elie Rouphael, PhD</h2>
        <p class="footer-meta">Location: <span style="color:antiquewhite">Grenoble, France</span></p>
      </div>
      <div class="footer-social" aria-hidden="false">
        <a href="mailto:elie.rouphael.98@gmail.com" aria-label="Email Elie" title="Email">
          <img src="/assets/svg/email.svg" alt="Email" aria-hidden="true" />
        </a>
        <a
          href="http://www.linkedin.com/in/elie-rouphael"
          aria-label="LinkedIn profile"
          title="LinkedIn"
          target="_blank"
          rel="noopener"
        >
          <img src="/assets/svg/linkedin.svg" alt="LinkedIn" aria-hidden="true" />
        </a>
        <a
          href="https://github.com/ElieRouphael"
          aria-label="GitHub profile"
          title="GitHub"
          target="_blank"
          rel="noopener"
        >
          <img src="/assets/svg/github.svg" alt="GitHub" aria-hidden="true" />
        </a>
        <a
          href="https://www.instagram.com/elierouphael"
          aria-label="Instagram profile"
          title="Instagram"
          target="_blank"
          rel="noopener"
        >
          <img src="/assets/svg/instagram.svg" alt="Instagram" aria-hidden="true" />
        </a>
        <a
          class="footer-cv-btn"
          href="/resume.pdf"
          download="Elie-Rouphael-Resume.pdf"
          aria-label="Download CV as PDF"
          title="Download CV"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>CV</span>
        </a>
      </div>
    </div>
    <p class="footer-copy">&copy; {year} Elie Rouphael</p>
  </div>
</footer>
