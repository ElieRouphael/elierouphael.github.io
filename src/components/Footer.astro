---
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner container">
    <div class="footer-body">
      <div class="footer-left">
        <h2 class="footer-name">Elie Rouphael, PhD</h2>
        <p class="footer-meta">Senior Lecturer &middot; University of Lille</p>
      </div>
      <div class="footer-social" aria-hidden="false">
        <a href="mailto:elie.rouphael@univ-lille.fr" aria-label="Email Elie" title="Email">
          <img src="/assets/svg/email.svg" alt="Email" aria-hidden="true" />
        </a>
        <a
          href="http://www.linkedin.com/in/elie-rouphael"
          aria-label="LinkedIn profile"
          title="LinkedIn"
          target="_blank"
          rel="noopener"
        >
          <img src="/assets/svg/linkedin.svg" alt="LinkedIn" aria-hidden="true" />
        </a>
        <a
          href="https://github.com/ElieRouphael"
          aria-label="GitHub profile"
          title="GitHub"
          target="_blank"
          rel="noopener"
        >
          <img src="/assets/svg/github.svg" alt="GitHub" aria-hidden="true" />
        </a>
        <a
          href="https://www.instagram.com/elierouphael"
          aria-label="Instagram profile"
          title="Instagram"
          target="_blank"
          rel="noopener"
        >
          <img src="/assets/svg/instagram.svg" alt="Instagram" aria-hidden="true" />
        </a>
      </div>
    </div>
    <p class="footer-copy">&copy; {year} Elie Rouphael</p>
  </div>
</footer>
