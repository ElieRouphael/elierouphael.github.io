---
interface Props {
  title: string;
  description: string;
  tag: string;
  metaTop: string;
  metaBottom: string;
  href?: string;
}

const { title, description, tag, metaTop, metaBottom, href = '#' } = Astro.props;
---

<a class="item-card" href={href} target="_blank" rel="noopener">
  <div class="item-body">
    <div class="item-title">{title}</div>
    <div class="item-desc">{description}</div>
    <span class="item-tag">{tag}</span>
  </div>
  <div class="item-meta">
    {metaTop}<br />
    <em>{metaBottom}</em>
  </div>
</a>
