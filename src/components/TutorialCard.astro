---
import type { Tutorial } from '../data/tutorials';

interface Props {
  tutorial: Tutorial;
}

const { title, description, topics, prerequisites, year, href, cover } = Astro.props.tutorial;
---

<a class:list={['tutorial-card', { 'has-cover': cover }]} href={href}>
  {
    cover && (
      <div class="tutorial-cover">
        <img src={cover.src} alt={cover.alt} loading="lazy" />
      </div>
    )
  }
  <div class="tutorial-body">
    <div class="item-title">{title}</div>
    <div class="item-desc">{description}</div>
    <div class="tutorial-topics">
      {topics.map((topic) => <span class="item-tag">{topic}</span>)}
    </div>
  </div>
  <div class="item-meta">
    {year}
    {
      prerequisites && (
        <>
          <br />
          <em>Assumes {prerequisites}</em>
        </>
      )
    }
  </div>
</a>
