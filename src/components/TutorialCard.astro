---
import type { Tutorial } from '../data/tutorials';

interface Props {
  tutorial: Tutorial;
}

const { title, description, topics, prerequisites, level, added, href, cover, draft } = Astro.props.tutorial;
const levelRank = { Beginner: 1, Intermediate: 2, Advanced: 3 }[level];
---

<a
  class:list={['tutorial-card', { 'has-cover': cover }]}
  href={href}
  data-title={title}
  data-level={levelRank}
  data-added={added}
>
  {
    cover && (
      <div class="tutorial-cover">
        <img src={cover.src} alt={cover.alt} loading="lazy" />
      </div>
    )
  }
  <div class="tutorial-body">
    <div class="item-title">
      {title}
      {draft && <span class="draft-badge">Draft &mdash; hidden from live site</span>}
    </div>
    <div class="item-desc">{description}</div>
    <div class="tutorial-topics">
      {topics.map((topic) => <span class="item-tag">{topic}</span>)}
    </div>
  </div>
  <div class="item-meta">
    <span class={`level-badge level-${level.toLowerCase()}`}>{level}</span>
    {
      prerequisites && (
        <div class="tutorial-prereq">
          <span class="meta-label">Prerequisites</span>
          {prerequisites}
        </div>
      )
    }
  </div>
</a>
