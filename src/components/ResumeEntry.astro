---
interface Props {
  title: string;
  org?: string;
  year?: string;
}

const { title, org, year } = Astro.props;
---

<div class="resume-entry">
  {
    year ? (
      <div class="resume-entry-header">
        <h3>{title}</h3>
        <span class="entry-year">{year}</span>
      </div>
    ) : (
      <h3>{title}</h3>
    )
  }
  {org && <p class="entry-org" set:html={org} />}
  <slot />
</div>
