---
import BaseLayout from '../layouts/BaseLayout.astro';
import TutorialCard from '../components/TutorialCard.astro';
import { tutorials } from '../data/tutorials';

// Draft tutorials only render locally (npm run dev), never in the deployed build.
const visibleTutorials = (import.meta.env.DEV ? tutorials : tutorials.filter((tutorial) => !tutorial.draft))
  .slice()
  .sort((a, b) => b.added.localeCompare(a.added)); // newest first, matching the default sort option
---

<BaseLayout title="Elie Rouphael — Tutorials">
  <div class="container">
    <div class="page-title">
      <h1>Tutorials</h1>
    </div>

    <div class="tutorial-sort">
      <label for="tutorial-sort">Sort by</label>
      <select id="tutorial-sort">
        <option value="newest">Newest first</option>
        <option value="oldest">Oldest first</option>
        <option value="level-asc">Level: beginner to advanced</option>
        <option value="level-desc">Level: advanced to beginner</option>
        <option value="name">Name (A–Z)</option>
      </select>
    </div>

    <div class="item-list" id="tutorial-list">
      {visibleTutorials.map((tutorial) => <TutorialCard tutorial={tutorial} />)}
    </div>
  </div>
</BaseLayout>

<script>
  const select = document.getElementById('tutorial-sort') as HTMLSelectElement;
  const list = document.getElementById('tutorial-list') as HTMLElement;
  const byName = (a: HTMLElement, b: HTMLElement) =>
    (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
  const byAdded = (a: HTMLElement, b: HTMLElement) =>
    (a.dataset.added ?? '').localeCompare(b.dataset.added ?? '');
  const byLevel = (a: HTMLElement, b: HTMLElement) =>
    Number(a.dataset.level) - Number(b.dataset.level);

  const comparators: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
    newest: (a, b) => byAdded(b, a),
    oldest: byAdded,
    'level-asc': (a, b) => byLevel(a, b) || byName(a, b),
    'level-desc': (a, b) => byLevel(b, a) || byName(a, b),
    name: byName,
  };

  function sortTutorials(key: string) {
    const cards = Array.from(list.querySelectorAll<HTMLElement>('.tutorial-card'));
    cards.sort(comparators[key] ?? comparators.newest).forEach((card) => list.appendChild(card));
  }

  try {
    const saved = localStorage.getItem('tutorial-sort');
    if (saved && saved in comparators) select.value = saved;
  } catch {}
  sortTutorials(select.value);

  select.addEventListener('change', () => {
    sortTutorials(select.value);
    try {
      localStorage.setItem('tutorial-sort', select.value);
    } catch {}
  });
</script>
