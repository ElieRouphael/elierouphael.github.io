---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResumeEntry from "../components/ResumeEntry.astro";
import {
  sidebar,
  experience,
  education,
  certifications,
  projects,
  publications,
  technicalSkills,
  references,
} from "../data/resume";
---

<BaseLayout title="Elie Rouphael \u2014 Resume">
  <div class="container">
    <div class="page-title">
      <h1>Curriculum Vitae</h1>
    </div>

    <div class="resume-layout">
      <!-- Sidebar -->
      <aside class="resume-sidebar">
        <h2 set:html={sidebar.name} />
        <p class="subtitle">{sidebar.subtitle}</p>

        <div class="resume-sidebar-section">
          <h3>Contact</h3>
          {sidebar.contact.map((line) => <p set:html={line} />)}
        </div>

        <div class="resume-sidebar-section">
          <h3>Languages</h3>
          <ul>
            {sidebar.languages.map((l) => <li>{l}</li>)}
          </ul>
        </div>

        <a class="btn-download" href="#" aria-label="Download CV as PDF">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Download PDF
        </a>
      </aside>

      <!-- Main content -->
      <div class="resume-main">
        <section>
          <h2>Research Interests</h2>
          <div>
            Stochastic realization theory, hybrid system identification,
            probabilistic modeling, digital twins, vehicle dynamics modeling,
            time series learning, Bayesian inference, deep state-space models,
            AI.
          </div>
        </section>

        <section>
          <h2>Education</h2>
          {
            education.map((entry) => (
              <ResumeEntry
                title={entry.title}
                org={entry.org}
                year={entry.year}
              >
                {entry.body && <p set:html={entry.body} />}
              </ResumeEntry>
            ))
          }
        </section>

        <section>
          <h2>Professional Experience</h2>
          {
            experience.map((entry) => (
              <ResumeEntry
                title={entry.title}
                org={entry.org}
                year={entry.year}
              >
                {entry.body && <p set:html={entry.body} />}
              </ResumeEntry>
            ))
          }
        </section>

        <section>
          <h2>Certifications & Courses</h2>
          {
            certifications.map((entry) => (
              <ResumeEntry
                title={entry.title}
                org={entry.org}
                year={entry.year}
              >
                {entry.body && <p set:html={entry.body} />}
              </ResumeEntry>
            ))
          }
        </section>

        <section>
          <h2>Selected Projects (Supervised)</h2>
          {
            projects.map((entry) => (
              <ResumeEntry
                title={entry.title}
                org={entry.org}
                year={entry.year}
              >
                {entry.body && <p set:html={entry.body} />}
              </ResumeEntry>
            ))
          }
        </section>

        <section>
          <h2>Publications</h2>
          {
            publications.map((entry) => (
              <ResumeEntry
                title={entry.title}
                org={entry.org}
                year={entry.year}
              >
                {entry.body && <p set:html={entry.body} />}
              </ResumeEntry>
            ))
          }
        </section>

        <section>
          <h2>Technical Skills</h2>
          {
            technicalSkills.map((entry) => (
              <ResumeEntry
                title={entry.title}
                org={entry.org}
                year={entry.year}
              >
                {entry.body && <p set:html={entry.body} />}
              </ResumeEntry>
            ))
          }
        </section>

        <section>
          <h2>References</h2>
          {
            references.map((entry) => (
              <ResumeEntry
                title={entry.title}
                org={entry.org}
                year={entry.year}
              >
                {entry.body && <p set:html={entry.body} />}
              </ResumeEntry>
            ))
          }
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
