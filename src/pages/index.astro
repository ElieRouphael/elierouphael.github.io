---
import BaseLayout from '../layouts/BaseLayout.astro';
import { bio } from '../data/bio';
import { Image } from 'astro:assets';
import elieProfile from '../assets/elie-img-1.jpg';
---

<BaseLayout title="Elie Rouphael">
  <div class="container">
    <section class="bio-section">
      <div class="bio-image">
        <Image src={elieProfile} alt="Elie Rouphael" />
      </div>
      <div class="bio-content">
        <h1>{bio.name}</h1>
        <p class="subtitle">{bio.subtitle}</p>
        {bio.paragraphs.map((p) => <p>{p}</p>)}
        <div class="bio-tags">
          {bio.tags.map((tag) => <span class="bio-tag">{tag}</span>)}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
