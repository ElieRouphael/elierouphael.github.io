---
import BaseLayout from '../layouts/BaseLayout.astro';
import { reads, type ReadEntry } from '../data/reads';

const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

// Family name for sorting: the last word, plus a preceding particle ("Van Schuppen", "de Beauvoir").
const PARTICLES = new Set(['van', 'von', 'de', 'der', 'den', 'da', 'di', 'du', 'del', 'le', 'la']);
const familyName = (author = '') => {
  const words = author.trim().split(/\s+/);
  let i = words.length - 1;
  while (i > 0 && PARTICLES.has(words[i - 1].toLowerCase())) i--;
  return words.slice(i).join(' ');
};
const byFamilyName = (a: ReadEntry, b: ReadEntry) =>
  familyName(a.author).localeCompare(familyName(b.author), 'en', { sensitivity: 'base' }) ||
  a.title.localeCompare(b.title, 'en');

// Every section becomes a list of groups; a section without subsections is one untitled group.
const sections = reads.map((section) => {
  const groups = [
    ...(section.entries ? [{ heading: undefined as string | undefined, entries: section.entries }] : []),
    ...(section.subsections ?? []),
  ].map((group) => ({ ...group, entries: [...group.entries].sort(byFamilyName) }));
  return {
    heading: section.heading,
    id: slugify(section.heading),
    count: groups.reduce((n, g) => n + g.entries.length, 0),
    groups,
  };
});
---

<BaseLayout title="Elie Rouphael — Suggested Reads">
  <div class="container reads-page">
    <div class="page-title">
      <h1>Suggested Reads</h1>
    </div>

    <nav class="reads-nav" aria-label="Sections">
      {
        sections.map((s) => (
          <a href={`#${s.id}`}>
            {s.heading} <span class="reads-count">{s.count}</span>
          </a>
        ))
      }
    </nav>

    {
      sections.map((section) => (
        <section class="reads-section" id={section.id}>
          <h2>
            {section.heading} <span class="reads-count">{section.count}</span>
          </h2>

          {section.groups.map((group) => (
            <div class="reads-group">
              {group.heading && <h3>{group.heading}</h3>}
              <ul class="reads-grid">
                {group.entries.map((entry) => (
                  <li class="reads-card">
                    <span class="reads-title">{entry.title}</span>
                    {entry.author && <span class="reads-author">{entry.author}</span>}
                    {entry.note && <span class="reads-note">{entry.note}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))
    }
  </div>
</BaseLayout>
