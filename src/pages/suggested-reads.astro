---
import BaseLayout from '../layouts/BaseLayout.astro';
import { reads } from '../data/reads';
---

<BaseLayout title="Elie Rouphael \u2014 Suggested Reads">
  <div class="container">
    <div class="page-title">
      <h1>Suggested Reads</h1>
    </div>

    {
      reads.map((section) => (
        <section class="reads-section">
          <h2>{section.heading}</h2>

          {section.entries && (
            <ul class="reads-list">
              {section.entries.map((entry) => (
                <li>
                  <span class="reads-title">{entry.title}</span>
                  {entry.author && (
                    <>
                      <span class="reads-sep"> {'\u2014'} </span>
                      <span class="reads-author">{entry.author}</span>
                    </>
                  )}
                  {entry.note && <div class="reads-note">{entry.note}</div>}
                </li>
              ))}
            </ul>
          )}

          {section.subsections?.map((sub) => (
            <div class="reads-subsection">
              <h3>{sub.heading}</h3>
              <ul class="reads-list">
                {sub.entries.map((entry) => (
                  <li>
                    <span class="reads-title">{entry.title}</span>
                    {entry.author && (
                      <>
                        <span class="reads-sep"> {'\u2014'} </span>
                        <span class="reads-author">{entry.author}</span>
                      </>
                    )}
                    {entry.note && <div class="reads-note">{entry.note}</div>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))
    }
  </div>
</BaseLayout>
