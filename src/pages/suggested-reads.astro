---
import BaseLayout from '../layouts/BaseLayout.astro';
import ItemCard from '../components/ItemCard.astro';
import { reads } from '../data/reads';
---

<BaseLayout title="Elie Rouphael \u2014 Suggested Reads">
  <div class="container">
    <div class="page-title">
      <h1>Suggested Reads</h1>
    </div>

    <div class="item-list">
      {
        reads.map((item) => (
          <ItemCard
            title={item.title}
            description={item.description}
            tag={item.tag}
            metaTop={item.author}
            metaBottom={item.source}
            href={item.href}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
