---
import BaseLayout from '../layouts/BaseLayout.astro';
import ItemCard from '../components/ItemCard.astro';
import { research, thesis } from '../data/research';
---

<BaseLayout title="Elie Rouphael — Research">
  <div class="container">
    <div class="page-title">
      <h1>Research</h1>
    </div>

    <section class="thesis-feature" aria-labelledby="thesis-heading">
      <div class="thesis-main">
        <p class="thesis-eyebrow">Doctoral thesis</p>
        <h2 id="thesis-heading" class="thesis-title">{thesis.title}</h2>
        <p class="thesis-subtitle">{thesis.subtitle} &middot; {thesis.university}, {thesis.defended}</p>
        {thesis.abstract.map((paragraph) => <p class="thesis-abstract">{paragraph}</p>)}
        <div class="thesis-actions">
          <a class="btn-download" href={thesis.href} target="_blank" rel="noopener">Read on HAL</a>
          <a class="btn-download" href={thesis.pdf} target="_blank" rel="noopener">Manuscript (PDF)</a>
        </div>
      </div>
      <aside class="thesis-side">
        <dl>
          <dt>University</dt>
          <dd>{thesis.university}</dd>
          <dt>Laboratory</dt>
          <dd>{thesis.laboratory}</dd>
          <dt>Graduate school</dt>
          <dd>{thesis.school}</dd>
          <dt>Supervisors</dt>
          <dd>{thesis.supervisors}</dd>
          <dt>Defended</dt>
          <dd>{thesis.defended}</dd>
          <dt>Jury</dt>
          <dd>{thesis.jury}</dd>
        </dl>
        <ul class="thesis-keywords" aria-label="Keywords">
          {thesis.keywords.map((keyword) => <li class="item-tag">{keyword}</li>)}
        </ul>
      </aside>
    </section>

    <h2 class="section-heading">Publications</h2>
    <div class="item-list">
      {
        research.map((item) => (
          <ItemCard
            title={item.title}
            description={item.description}
            tag={item.tag}
            metaTop={item.year}
            metaBottom={item.venue}
            href={item.href}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
